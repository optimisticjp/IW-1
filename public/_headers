# Cloudflare Pages headers (served from the build output root).
# Static-first site: long-cache the fingerprinted assets, short-cache images,
# and apply a few safe, standard security headers. No CSP is set here because
# the site uses Astro's inline module scripts and inline styles; a strict CSP
# would need per-build hashes/nonces and is intentionally left for a later pass.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: browsing-topics=()

# Fingerprinted build assets — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets (favicon, OG image) — moderate cache.
/og/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
