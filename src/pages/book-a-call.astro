---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BookingForm from '../components/forms/BookingForm.astro';
import { webPageSchema } from '../lib/schema';
import { buildSeo } from '../lib/seo';

// Surface the single required production config value at build time, so a
// misconfigured deploy is caught in the build log rather than silently
// dropping leads.
if (import.meta.env.PROD && !import.meta.env.PUBLIC_BOOKING_ENDPOINT) {
  console.warn(
    '[booking] PUBLIC_BOOKING_ENDPOINT is not set — production booking submissions will NOT be delivered. Set it before deploying (see .env.example).'
  );
}

const seo = {
  title: 'Book a free call',
  description:
    'Tell us about your business and we’ll show you exactly where your growth is leaking and what we’d do about it. No pressure, no jargon, no obligation.',
  path: '/book-a-call',
};

const site = Astro.site ?? new URL('https://www.infiniteweblinks.example');
const meta = buildSeo(seo, site);
const schemas = [webPageSchema(meta.title, meta.canonical, seo.description)];

const steps = [
  { n: '01', t: 'You tell us a bit', d: 'A few details about your business and what you’re trying to reach. Two minutes, tops.' },
  { n: '02', t: 'We map your Growth Graph', d: 'We look at how your tools connect today and find where value leaks out between them.' },
  { n: '03', t: 'You get a clear plan', d: 'A friendly walkthrough of what we’d do and what it’s worth. No pressure, no obligation.' },
];
---

<BaseLayout seo={seo} schemas={schemas}>
  <Section env="paper" id="top" width="wide" pad="loose" class="book" labelledby="book-h">
    <div class="book__grid">
      <div class="book__intro">
        <Eyebrow>Book a free call</Eyebrow>
        <h1 id="book-h" class="book__head">Let’s map your <span class="grad-text">Growth Graph</span>.</h1>
        <p class="book__sub">Tell us about your business, and we’ll show you exactly where your growth is leaking and what we’d do about it. No pressure, no jargon, no obligation.</p>
        <ol class="book__steps">
          {steps.map((s) => (
            <li class="book__step">
              <span class="book__step-n">{s.n}</span>
              <div>
                <h2 class="book__step-t">{s.t}</h2>
                <p class="book__step-d">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="book__trust">Built for solo experts and in-house teams alike.</p>
      </div>

      <div class="book__panel">
        <BookingForm />
        <p class="book__privacy">We only use your details to reply. See our approach to privacy before launch.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .book__grid { display: grid; gap: clamp(2rem, 1rem + 5vw, 4rem); align-items: start; }
  .book__intro { min-width: 0; }
  .book__head { font-size: var(--fs-h1); margin-top: 1rem; }
  .book__sub { font-size: var(--fs-lead); color: var(--fg-muted); max-width: 46ch; margin-top: 1.2rem; }
  .book__steps { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.1rem; }
  .book__step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .book__step-n { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--c-indigo); font-weight: 700; padding-top: 0.3rem; }
  .book__step-t { font-size: var(--fs-h4); }
  .book__step-d { color: var(--fg-muted); margin-top: 0.2rem; max-width: 42ch; }
  .book__trust { margin-top: 1.8rem; color: var(--fg-faint); font-size: var(--fs-small); }

  .book__panel { min-width: 0; background: var(--bg-inset); border-radius: var(--r-4); padding: clamp(1.4rem, 1rem + 2vw, 2.4rem); }
  .book__privacy { margin-top: 1.1rem; color: var(--fg-faint); font-size: var(--fs-caption); }

  @media (min-width: 940px) {
    .book__grid { grid-template-columns: 1fr 1.05fr; }
  }
</style>
