---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import TextLink from '../components/ui/TextLink.astro';
import Line from '../components/brand/Line.astro';
import Campaign from '../components/brand/Campaign.astro';
import Storefront from '../components/brand/Storefront.astro';
import RetentionLoop from '../components/brand/RetentionLoop.astro';
import AnalyticsPanel from '../components/brand/AnalyticsPanel.astro';
import ContentStream from '../components/brand/ContentStream.astro';
import FlowMarker from '../components/brand/FlowMarker.astro';
import ProofModule from '../components/modules/ProofModule.astro';
import TestimonialModule from '../components/modules/TestimonialModule.astro';
import LogoWall from '../components/modules/LogoWall.astro';
import CTASection from '../components/modules/CTASection.astro';
import { home } from '../data/home';
import { pillars, foundation } from '../data/pillars';

const objFor: Record<string, any> = {
  demand: Campaign, storefront: Storefront, retention: RetentionLoop, intelligence: AnalyticsPanel,
};
const proofAccents = ['orange', 'green', 'violet', 'blue'] as const;
---

<BaseLayout seo={home.meta} siteSchema>
  <!-- 1 · HERO / positioning ------------------------------------------- -->
  <Section env="cream" width="wide" pad="loose" class="hero" labelledby="hero-h">
    <div class="hero__grid">
      <div class="hero__copy">
        <Eyebrow>{home.hero.kicker}</Eyebrow>
        <h1 id="hero-h" class="hero__head">
          <span class="hero__line">{home.hero.headlineLead} <em class="is-leak">{home.hero.headlineLeak}</em></span>
          <span class="hero__line">{home.hero.headlineConnect} <em class="is-compound">{home.hero.headlineCompound}</em></span>
        </h1>
        <p class="hero__sub">{home.hero.sub}</p>
        <div class="hero__actions">
          <Button href={home.hero.primaryCta.href} variant="primary" size="lg">{home.hero.primaryCta.label}</Button>
          <Button href={home.hero.secondaryCta.href} variant="secondary" size="lg">{home.hero.secondaryCta.label}</Button>
        </div>
        <ul class="hero__signals" aria-label="What we run">
          {home.hero.signals.map((s) => <li><Tag accent="muted">{s}</Tag></li>)}
        </ul>
      </div>

      <div class="hero__stage" aria-hidden="true">
        <div class="hero__blobs">
          <span class="blob blob--o"></span>
          <span class="blob blob--b"></span>
          <span class="blob blob--g"></span>
          <span class="blob blob--v"></span>
        </div>
        <div class="hero__scene">
          <div class="hline"><Line variant="flow" width={6} /></div>
          <div class="chip chip--a"><div class="chip__obj"><Campaign /></div><span class="chip__tag chip__tag--o">Demand</span></div>
          <div class="chip chip--b"><div class="chip__obj"><Storefront /></div><span class="chip__tag chip__tag--bl">Storefront</span></div>
          <div class="chip chip--c"><div class="chip__obj"><RetentionLoop /></div><span class="chip__tag chip__tag--g">Retention</span></div>
          <div class="chip chip--d"><div class="chip__obj"><AnalyticsPanel /></div><span class="chip__tag chip__tag--v">Intelligence</span></div>
          <span class="pop pop--orders">New order ✦</span>
          <span class="pop pop--roas">Compounding ↗</span>
        </div>
      </div>
    </div>
  </Section>

  <!-- 2 · Cost of disconnected growth ---------------------------------- -->
  <Section env="peach" width="content" class="disc" labelledby="disc-h">
    <div class="disc__head u-reveal">
      <Eyebrow>{home.disconnected.kicker}</Eyebrow>
      <h2 id="disc-h" class="section-head">{home.disconnected.heading}</h2>
      <p class="lead">{home.disconnected.body}</p>
    </div>
    <ul class="disc__leaks">
      {home.disconnected.leaks.map((leak, i) => (
        <li class="leak u-reveal" style={`--reveal-delay:${i * 80}ms`}>
          <span class="leak__where">{leak.where}</span>
          <span class="leak__loss">{leak.loss}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 3 · Signature: Leak to Compound ---------------------------------- -->
  <Section env="cream" width="content" class="lc" labelledby="lc-h">
    <div class="lc__head u-reveal">
      <Eyebrow>Leak → Compound</Eyebrow>
      <h2 id="lc-h" class="section-head">The same effort, two very different outcomes.</h2>
    </div>
    <div class="lc__grid">
      <figure class="lc__panel lc__panel--leak u-reveal">
        <figcaption class="lc__label"><span class="lc__dot lc__dot--leak" aria-hidden="true"></span>Disconnected</figcaption>
        <div class="lc__vis"><Line variant="flow" state="leak" /></div>
        <p class="lc__note">Value drips out between the gaps. You spend more to stand still.</p>
        <span class="lc__delta lc__delta--down">value leaks</span>
      </figure>
      <figure class="lc__panel lc__panel--comp u-reveal" style="--reveal-delay:120ms">
        <figcaption class="lc__label"><span class="lc__dot lc__dot--comp" aria-hidden="true"></span>Connected</figcaption>
        <div class="lc__vis"><Line variant="flow" state="continuous" width={6} /></div>
        <p class="lc__note">Each system hands value to the next. The same spend does more, then more again.</p>
        <span class="lc__delta lc__delta--up">value compounds</span>
      </figure>
    </div>
  </Section>

  <!-- 4 · Connected ecosystem — Signature: The Connection -------------- -->
  <Section env="sky" width="wide" id="connected" class="conn" labelledby="conn-h">
    <div class="conn__grid">
      <div class="conn__copy u-reveal">
        <Eyebrow>{home.connected.kicker}</Eyebrow>
        <h2 id="conn-h" class="section-head">{home.connected.heading}</h2>
        <p class="lead">{home.connected.body}</p>
        <div class="conn__foundation">
          <div class="conn__foundation-obj" aria-hidden="true"><ContentStream /></div>
          <p><strong>{foundation.name}.</strong> {foundation.role}</p>
        </div>
      </div>

      <figure class="conn__loop u-reveal" style="--reveal-delay:120ms">
        <svg class="loop" viewBox="0 0 560 360" role="presentation" aria-hidden="true">
          <defs>
            <linearGradient id="loopgrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="var(--c-orange)" />
              <stop offset="40%" stop-color="var(--c-blue)" />
              <stop offset="70%" stop-color="var(--c-green)" />
              <stop offset="100%" stop-color="var(--c-violet)" />
            </linearGradient>
          </defs>
          <path class="loop__track" d="M120 60 H440 A60 60 0 0 1 440 300 H120 A60 60 0 0 1 120 60 Z"
                fill="none" stroke="var(--rule-strong)" stroke-width="2"/>
          <path class="loop__draw line__draw" d="M120 60 H440 A60 60 0 0 1 440 300 H120 A60 60 0 0 1 120 60 Z"
                fill="none" stroke="url(#loopgrad)" stroke-width="5" stroke-linecap="round"/>
        </svg>
        <ul class="loop__labels">
          <li class="loop__label loop__label--tl"><FlowMarker accent="orange" /> Demand</li>
          <li class="loop__label loop__label--tr"><FlowMarker accent="blue" /> Storefront</li>
          <li class="loop__label loop__label--br"><FlowMarker accent="green" /> Retention</li>
          <li class="loop__label loop__label--bl"><FlowMarker accent="violet" /> Intelligence</li>
        </ul>
      </figure>
    </div>
    <p class="conn__closure u-reveal">Demand → Storefront → Retention → Intelligence → <span class="conn__back">back into Demand</span>. That’s the loop.</p>
  </Section>

  <!-- 5 · The four pillars in detail ----------------------------------- -->
  <Section env="cream" width="wide" class="pil" labelledby="pil-h">
    <div class="pil__head u-reveal">
      <Eyebrow>Four connected systems</Eyebrow>
      <h2 id="pil-h" class="section-head">Demand, Storefront, Retention, Intelligence.</h2>
    </div>
    <ul class="pil__grid">
      {pillars.map((p, i) => {
        const Obj = objFor[p.key];
        return (
          <li class:list={['pcard', `pcard--${p.accent}`, 'u-reveal']} style={`--reveal-delay:${i * 70}ms`}>
            <div class="pcard__top">
              <span class="pcard__idx">{p.index}</span>
              <div class="pcard__obj"><Obj /></div>
            </div>
            <h3 class="pcard__name">{p.name}</h3>
            <p class="pcard__role">{p.role}</p>
            <p class="pcard__line">{p.lineRole}</p>
            <ul class="pcard__svc">
              {p.services.slice(0, 5).map((s) => <li><Tag accent={p.accent}>{s}</Tag></li>)}
            </ul>
          </li>
        );
      })}
    </ul>
  </Section>

  <!-- 6 · Five priority services --------------------------------------- -->
  <Section env="lemon" width="wide" class="svc" labelledby="svc-h">
    <div class="svc__head u-reveal">
      <Eyebrow>{home.services.kicker}</Eyebrow>
      <h2 id="svc-h" class="section-head">{home.services.heading}</h2>
      <p class="lead">{home.services.body}</p>
    </div>
    <ul class="svc__grid">
      {home.services.items.map((s, i) => (
        <li class:list={['scard', `scard--${['orange','blue','green','violet','pink'][i]}`, 'u-reveal']} style={`--reveal-delay:${i * 60}ms`}>
          <a class="scard__link" href={s.href}>
            <span class="scard__dot" aria-hidden="true"></span>
            <span class="scard__pillar">{s.pillar}</span>
            <h3 class="scard__name">{s.name}</h3>
            <p class="scard__promise">{s.promise}</p>
            <span class="scard__connect">{s.connects}</span>
            <span class="scard__cta" aria-hidden="true">Explore <span>→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 7 · Contextual proof --------------------------------------------- -->
  <Section env="mint" width="wide" class="prf" labelledby="prf-h">
    <div class="prf__head u-reveal">
      <Eyebrow>{home.proof.kicker}</Eyebrow>
      <h2 id="prf-h" class="section-head">{home.proof.heading}</h2>
      <p class="lead">{home.proof.body}</p>
    </div>
    <div class="prf__body">
      <ul class="prf__metrics">
        {home.proof.metrics.map((m, i) => (
          <li class="u-reveal" style={`--reveal-delay:${i * 70}ms`}>
            <ProofModule value={m.value} label={m.label} system={m.system} assetStatus={m.assetStatus} accent={proofAccents[i % proofAccents.length]} />
          </li>
        ))}
      </ul>
      <div class="prf__quote u-reveal">
        <TestimonialModule
          quote={home.proof.testimonial.quote}
          name={home.proof.testimonial.name}
          role={home.proof.testimonial.role}
          brand={home.proof.testimonial.brand}
          assetStatus={home.proof.testimonial.assetStatus}
        />
      </div>
    </div>
    <div class="prf__logos u-reveal">
      <LogoWall count={home.proof.logoCount} note={home.proof.logosNote} />
    </div>
  </Section>

  <!-- 8 · How Infinite Weblinks works ---------------------------------- -->
  <Section env="cream" width="content" class="how" labelledby="how-h">
    <div class="how__head u-reveal">
      <Eyebrow>{home.how.kicker}</Eyebrow>
      <h2 id="how-h" class="section-head">{home.how.heading}</h2>
    </div>
    <ol class="how__steps">
      {home.how.steps.map((step, i) => (
        <li class:list={['hstep', `hstep--${['orange','blue','green'][i]}`, 'u-reveal']} style={`--reveal-delay:${i * 90}ms`}>
          <span class="hstep__n">{step.n}</span>
          <div>
            <h3 class="hstep__title">{step.title}</h3>
            <p class="hstep__text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 9 · Secondary audience paths ------------------------------------- -->
  <Section env="lavender" width="content" pad="tight" class="sec" labelledby="sec-h">
    <div class="sec__head u-reveal">
      <Eyebrow>{home.secondary.kicker}</Eyebrow>
      <h2 id="sec-h" class="section-head section-head--sm">{home.secondary.heading}</h2>
    </div>
    <ul class="sec__grid">
      {home.secondary.paths.map((p) => (
        <li class="sec__card u-reveal">
          <h3 class="sec__name">{p.label}</h3>
          <p class="sec__text">{p.text}</p>
          <TextLink href={p.href}>Take this path</TextLink>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 10 · Final proposal invitation ----------------------------------- -->
  <CTASection
    id="proposal"
    env="flare"
    kicker={home.finalCta.kicker}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
    cta={home.finalCta.cta}
    reassurance={home.finalCta.reassurance}
  />
</BaseLayout>

<style>
  /* Shared typography ------------------------------------------------- */
  .section-head { font-size: var(--fs-h2); max-width: 18ch; margin-top: 0.7rem; }
  .section-head--sm { font-size: var(--fs-h3); }
  .lead { font-size: var(--fs-lead); color: var(--fg-muted); max-width: 48ch; margin-top: 1.1rem; }

  /* 1 · Hero ---------------------------------------------------------- */
  .hero__grid { display: grid; gap: clamp(2.5rem, 1rem + 6vw, 4.5rem); align-items: center; }
  .hero__copy { min-width: 0; }
  .hero__head { font-size: var(--fs-h1); margin: 1.2rem 0 0; display: grid; }
  .hero__line { display: block; }
  .hero__head em { font-style: normal; }
  .hero__head .is-leak { color: var(--c-orange-deep); }
  .hero__head .is-compound { color: var(--c-green-deep); }
  .hero__sub { font-size: var(--fs-lead); color: var(--fg-muted); max-width: 52ch; margin-top: 1.5rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero__signals { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 2rem 0 0; }

  /* Hero ecosystem stage */
  .hero__stage {
    position: relative;
    min-width: 0;
    border-radius: var(--r-4);
    padding: clamp(1.2rem, 0.5rem + 3vw, 2.4rem);
    background: var(--bg-raised);
    box-shadow: var(--shadow-pop);
    overflow: clip;
  }
  .hero__blobs { position: absolute; inset: 0; z-index: 0; }
  .blob { position: absolute; border-radius: 50%; filter: blur(34px); opacity: 0.5; }
  .blob--o { width: 46%; height: 46%; background: var(--c-orange); top: -8%; left: -6%; }
  .blob--b { width: 42%; height: 42%; background: var(--c-blue); bottom: -6%; right: -4%; }
  .blob--g { width: 34%; height: 34%; background: var(--c-green); bottom: 8%; left: -8%; opacity: 0.4; }
  .blob--v { width: 30%; height: 30%; background: var(--c-violet); top: 4%; right: 6%; opacity: 0.4; }

  .hero__scene {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.7rem, 2vw, 1.3rem);
  }
  .hline { position: absolute; inset-inline: 6%; top: 50%; translate: 0 -50%; z-index: 0; opacity: 0.9; }
  .chip {
    position: relative; z-index: 1;
    background: var(--c-ivory);
    border-radius: var(--r-3);
    padding: clamp(0.8rem, 0.4rem + 1.5vw, 1.3rem);
    box-shadow: var(--shadow-2);
    display: grid; gap: 0.5rem; justify-items: start;
  }
  .chip__obj { width: clamp(2.6rem, 5vw, 3.6rem); }
  .chip--a { rotate: -3deg; }
  .chip--b { rotate: 2.5deg; margin-top: clamp(0.6rem, 2vw, 1.4rem); }
  .chip--c { rotate: 2deg; margin-top: clamp(-0.6rem, -2vw, -0.4rem); }
  .chip--d { rotate: -2.5deg; }
  .chip__tag {
    font-family: var(--font-body); font-weight: 700; font-size: var(--fs-caption);
    padding: 0.2em 0.6em; border-radius: var(--r-pill);
  }
  .chip__tag--o { background: color-mix(in oklab, var(--c-orange) 18%, var(--c-ivory)); color: var(--c-orange-deep); }
  .chip__tag--bl { background: color-mix(in oklab, var(--c-blue) 18%, var(--c-ivory)); color: var(--c-blue-deep); }
  .chip__tag--g { background: color-mix(in oklab, var(--c-green) 18%, var(--c-ivory)); color: var(--c-green-deep); }
  .chip__tag--v { background: color-mix(in oklab, var(--c-violet) 18%, var(--c-ivory)); color: var(--c-violet-deep); }
  .pop {
    position: absolute; z-index: 2;
    font-family: var(--font-body); font-weight: 700; font-size: var(--fs-caption);
    padding: 0.4em 0.75em; border-radius: var(--r-pill);
    background: var(--c-ink); color: var(--c-cream);
    box-shadow: var(--shadow-2); white-space: nowrap;
  }
  .pop--orders { top: 42%; left: 44%; translate: -50% -50%; background: var(--c-green); color: #06301f; }
  .pop--roas { bottom: 6%; left: 50%; translate: -50% 0; background: var(--c-ink); color: var(--c-cream); }

  @media (min-width: 940px) {
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; }
    .hero__stage { aspect-ratio: 1 / 1; display: grid; align-content: center; }
  }

  /* 2 · Disconnected -------------------------------------------------- */
  .disc__leaks { list-style: none; padding: 0; margin: clamp(2rem, 1rem + 3vw, 3.5rem) 0 0; display: grid; gap: 0.9rem; }
  .leak {
    display: grid; gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    background: var(--bg-raised);
    border-radius: var(--r-2);
    border-left: 5px solid var(--accent);
    box-shadow: var(--shadow-1);
  }
  .leak__where { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--c-orange-deep); font-weight: 600; }
  .leak__loss { font-size: var(--fs-h4); font-family: var(--font-display); font-weight: 700; line-height: 1.25; letter-spacing: var(--tracking-tight); text-wrap: balance; }
  @media (min-width: 720px) {
    .disc__leaks { grid-template-columns: 1fr 1fr; }
  }

  /* 3 · Leak to Compound --------------------------------------------- */
  .lc__grid { display: grid; gap: 1.25rem; margin-top: clamp(2rem, 1rem + 3vw, 3rem); }
  .lc__panel {
    padding: clamp(1.5rem, 1rem + 2vw, 2.4rem);
    border-radius: var(--r-3);
    display: grid; gap: 1rem;
    box-shadow: var(--shadow-1);
  }
  .lc__panel--leak { background: color-mix(in oklab, var(--fg) 5%, var(--bg-raised)); }
  .lc__panel--leak .lc__vis { filter: grayscale(0.7); opacity: 0.85; }
  .lc__panel--comp { background: var(--bg-raised); border: var(--bw-2) solid color-mix(in oklab, var(--c-green) 35%, transparent); }
  .lc__label { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-weight: 700; font-size: var(--fs-caption); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .lc__dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .lc__dot--leak { background: var(--fg-faint); }
  .lc__dot--comp { background: var(--c-green); }
  .lc__note { color: var(--fg-muted); }
  .lc__delta { font-family: var(--font-body); font-weight: 700; font-size: var(--fs-caption); padding: 0.28rem 0.7rem; border-radius: var(--r-pill); justify-self: start; }
  .lc__delta--down { color: var(--fg-muted); background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .lc__delta--up { color: #06301f; background: var(--c-green); }
  @media (min-width: 720px) { .lc__grid { grid-template-columns: 1fr 1fr; } }

  /* 4 · Connection ---------------------------------------------------- */
  .conn__grid { display: grid; gap: clamp(2rem, 1rem + 5vw, 4rem); align-items: center; }
  .conn__foundation { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; padding: 1rem 1.2rem; background: var(--bg-raised); border-radius: var(--r-3); color: var(--fg-muted); max-width: 48ch; box-shadow: var(--shadow-1); }
  .conn__foundation strong { color: var(--fg); }
  .conn__foundation-obj { width: 3rem; flex: none; }
  .conn__loop { position: relative; margin: 0; }
  .loop { width: 100%; height: auto; overflow: visible; filter: drop-shadow(0 10px 20px color-mix(in oklab, var(--c-blue) 22%, transparent)); }
  .loop__labels { list-style: none; margin: 0; padding: 0; }
  .loop__label {
    position: absolute; display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--c-ivory); padding: 0.35rem 0.7rem;
    border-radius: var(--r-pill); font-weight: 700; font-size: var(--fs-small); white-space: nowrap;
    box-shadow: var(--shadow-1);
  }
  .loop__label--tl { top: 4%; left: 2%; }
  .loop__label--tr { top: 4%; right: 2%; }
  .loop__label--br { bottom: 4%; right: 2%; }
  .loop__label--bl { bottom: 4%; left: 2%; }
  .conn__closure { margin-top: 2rem; font-family: var(--font-body); font-weight: 600; font-size: var(--fs-small); color: var(--fg-muted); text-align: center; text-wrap: balance; }
  .conn__back { color: var(--c-orange-deep); }
  @media (min-width: 900px) { .conn__grid { grid-template-columns: 1fr 1fr; } }

  /* 5 · Pillars ------------------------------------------------------- */
  .pil__grid { list-style: none; padding: 0; margin: clamp(2rem, 1rem + 3vw, 3rem) 0 0; display: grid; gap: 1rem; }
  .pcard {
    border-radius: var(--r-3);
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    display: grid; gap: 0.7rem; align-content: start;
    box-shadow: var(--shadow-1);
  }
  .pcard--orange { background: var(--tint-peach); }
  .pcard--blue { background: var(--tint-sky); }
  .pcard--green { background: var(--tint-mint); }
  .pcard--violet { background: var(--tint-lavender); }
  .pcard__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pcard__idx { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h4); color: var(--fg-faint); }
  .pcard__obj { width: 3.6rem; }
  .pcard__name { font-size: var(--fs-h3); }
  .pcard__role { color: var(--fg); font-weight: 500; }
  .pcard__line { color: var(--fg-muted); font-size: var(--fs-small); }
  .pcard__svc { list-style: none; padding: 0; margin: 0.4rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  @media (min-width: 620px) { .pil__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .pil__grid { grid-template-columns: repeat(4, 1fr); } }

  /* 6 · Services ------------------------------------------------------ */
  .svc__grid { list-style: none; padding: 0; margin: clamp(2rem, 1rem + 3vw, 3rem) 0 0; display: grid; gap: 1rem; }
  .scard { display: grid; --sc: var(--c-orange); }
  .scard--orange { --sc: var(--c-orange); }
  .scard--blue { --sc: var(--c-blue); }
  .scard--green { --sc: var(--c-green); }
