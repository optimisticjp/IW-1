---
// Dev-only placeholder indicator. Renders ONLY during `astro dev`
// (import.meta.env.DEV) and is completely absent from production builds, so
// no "placeholder/pending/TODO" label ever reaches the public site. Used to
// keep pending assets visible to the team while building. Audited by T086.
interface Props { note?: string; }
const { note = 'Placeholder content — pending approved asset' } = Astro.props;
const isDev = import.meta.env.DEV;
---
{isDev && (
  <span class="ph-badge" title={note} aria-hidden="true">◊ placeholder</span>
)}
<style>
  .ph-badge {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 5;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
    border-radius: var(--r-pill);
    background: repeating-linear-gradient(45deg, #00000018, #00000018 4px, transparent 4px, transparent 8px);
    border: 1px dashed var(--fg-faint);
    color: var(--fg-muted);
    pointer-events: none;
  }
</style>
