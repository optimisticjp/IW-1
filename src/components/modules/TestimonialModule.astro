---
import PlaceholderBadge from './PlaceholderBadge.astro';
interface Props {
  quote: string;
  name: string;
  role: string;
  brand: string;
  assetStatus: 'pending' | 'approved';
}
const { quote, name, role, brand, assetStatus } = Astro.props;
---
<figure class="quote">
  {assetStatus === 'pending' && <PlaceholderBadge note="Testimonial pending approval" />}
  <p class="quote__mark" aria-hidden="true">“</p>
  <blockquote class="quote__body">{quote}</blockquote>
  <figcaption class="quote__cite">
    <span class="quote__avatar" aria-hidden="true">{name.charAt(0)}</span>
    <span>
      <strong>{name}</strong><br />
      <span class="quote__role">{role}, {brand}</span>
    </span>
  </figcaption>
</figure>
<style>
  .quote {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: clamp(1.8rem, 1.2rem + 2vw, 2.8rem);
    background: var(--bg-raised);
    border-radius: var(--r-4);
    box-shadow: var(--shadow-2);
  }
  .quote__mark {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 4rem;
    line-height: 0.6;
    color: var(--accent);
    height: 1.6rem;
  }
  .quote__body {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h4);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  .quote__cite { display: flex; align-items: center; gap: 0.9rem; font-size: var(--fs-small); }
  .quote__avatar {
    width: 2.8rem; height: 2.8rem; flex: none;
    display: grid; place-items: center;
    border-radius: var(--r-pill);
    background: var(--accent-2); color: #fff;
    font-family: var(--font-display); font-weight: 800;
  }
  .quote__role { color: var(--fg-muted); }
</style>
