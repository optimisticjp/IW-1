---
// Placeholder client-logo wall. Generic wordmarks so the wall looks complete
// without inventing real client brands; flagged dev-only.
import PlaceholderBadge from './PlaceholderBadge.astro';
interface Props { count?: number; note?: string; }
const { count = 6, note = 'Selected brands we’ve worked with' } = Astro.props;
const marks = ['NORTHBOUND', 'Vela&Co', 'HARVEST', 'lumen', 'Meridian', 'FORM', 'Atlas Goods', 'Peckham'];
const shown = marks.slice(0, count);
---
<div class="wall" role="group" aria-label={note}>
  <p class="wall__note">{note}</p>
  <ul class="wall__grid">
    {shown.map((m) => (
      <li class="wall__item">
        <PlaceholderBadge note="Client logo pending" />
        <span class="wall__mark">{m}</span>
      </li>
    ))}
  </ul>
</div>
<style>
  .wall { display: grid; gap: 1.1rem; }
  .wall__note {
    font-family: var(--font-body); font-weight: 600;
    font-size: var(--fs-caption); letter-spacing: var(--tracking-label);
    text-transform: uppercase; color: var(--fg-faint);
  }
  .wall__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem;
  }
  .wall__item {
    position: relative;
    display: grid; place-items: center;
    padding: 1.1rem 0.75rem;
    background: var(--bg-raised);
    border-radius: var(--r-2);
    min-height: 66px;
    box-shadow: var(--shadow-1);
  }
  .wall__mark {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--fg-muted);
    font-size: var(--fs-body);
  }
  @media (min-width: 560px) { .wall__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .wall__grid { grid-template-columns: repeat(6, 1fr); } }
</style>
