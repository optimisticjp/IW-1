---
// Analytics Panel — the truth that sharpens every other decision.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <rect x="16" y="24" width="96" height="80" rx="5" fill="var(--bg-raised)" stroke="var(--fg)" stroke-width="2.5"/>
  <line x1="16" y1="40" x2="112" y2="40" stroke="var(--fg)" stroke-width="2"/>
  <circle cx="24" cy="32" r="2.4" fill="var(--accent)"/>
  <circle cx="32" cy="32" r="2.4" fill="var(--saffron, #f4a72c)"/>
  <rect x="28" y="72" width="12" height="20" rx="2" fill="var(--accent-2)"/>
  <rect x="46" y="60" width="12" height="32" rx="2" fill="var(--fg)" opacity="0.5"/>
  <rect x="64" y="66" width="12" height="26" rx="2" fill="var(--accent-2)"/>
  <rect x="82" y="52" width="12" height="40" rx="2" fill="var(--accent)"/>
  <path d="M28 62 L52 54 L70 58 L94 46" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="94" cy="46" r="4" fill="var(--accent)" stroke="var(--bg-raised)" stroke-width="2"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; }
</style>
