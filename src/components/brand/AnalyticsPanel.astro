---
// Analytics Panel — the truth that sharpens every other decision.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <rect x="14" y="22" width="100" height="84" rx="12" fill="var(--c-ivory)"/>
  <rect x="14" y="22" width="100" height="84" rx="12" fill="none" stroke="var(--c-ink)" stroke-width="2.5" opacity="0.1"/>
  <rect x="14" y="22" width="100" height="18" rx="12" fill="var(--c-blue)"/>
  <circle cx="24" cy="31" r="2.6" fill="#fff"/>
  <circle cx="33" cy="31" r="2.6" fill="#fff" opacity="0.7"/>
  <rect x="28" y="74" width="13" height="20" rx="4" fill="var(--c-green)"/>
  <rect x="47" y="62" width="13" height="32" rx="4" fill="var(--c-violet)"/>
  <rect x="66" y="68" width="13" height="26" rx="4" fill="var(--c-pink)"/>
  <rect x="85" y="54" width="13" height="40" rx="4" fill="var(--c-orange)"/>
  <path d="M30 60 L54 52 L72 56 L96 44" fill="none" stroke="var(--c-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
  <circle cx="96" cy="44" r="5" fill="var(--c-yellow)" stroke="var(--c-ivory)" stroke-width="2.5"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; filter: drop-shadow(0 8px 14px color-mix(in oklab, var(--c-blue) 22%, transparent)); }
</style>
