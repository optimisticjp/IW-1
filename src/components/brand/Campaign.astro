---
// Campaign — paid demand: a bright signal reaching an audience.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <circle cx="34" cy="66" r="15" fill="var(--c-pink)"/>
  <circle cx="30" cy="62" r="4" fill="#fff" opacity="0.8"/>
  <path d="M52 52 q16 14 0 28" fill="none" stroke="var(--c-orange)" stroke-width="3.5" stroke-linecap="round"/>
  <path d="M60 44 q28 22 0 44" fill="none" stroke="var(--c-yellow)" stroke-width="3.5" stroke-linecap="round"/>
  <path d="M68 36 q40 30 0 60" fill="none" stroke="var(--c-violet)" stroke-width="3.5" stroke-linecap="round" opacity="0.85"/>
  <rect x="86" y="30" width="24" height="24" rx="7" fill="var(--c-blue)"/>
  <rect x="96" y="52" width="20" height="20" rx="6" fill="var(--c-green)"/>
  <rect x="86" y="74" width="24" height="24" rx="7" fill="var(--c-yellow)"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; filter: drop-shadow(0 8px 14px color-mix(in oklab, var(--c-pink) 22%, transparent)); }
</style>
