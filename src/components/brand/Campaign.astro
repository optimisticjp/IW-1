---
// Campaign — paid demand: signal reaching an audience.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <circle cx="34" cy="64" r="12" fill="var(--accent)" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M50 52 q16 12 0 24" fill="none" stroke="var(--fg)" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M58 44 q28 20 0 40" fill="none" stroke="var(--accent-2)" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M66 36 q40 28 0 56" fill="none" stroke="var(--fg)" stroke-width="2.5" stroke-linecap="round" opacity="0.55"/>
  <rect x="86" y="30" width="22" height="22" rx="3" fill="var(--bg-raised)" stroke="var(--fg)" stroke-width="2.5"/>
  <rect x="86" y="76" width="22" height="22" rx="3" fill="var(--saffron, #f4a72c)" stroke="var(--fg)" stroke-width="2.5"/>
  <rect x="98" y="53" width="18" height="18" rx="3" fill="var(--bg-raised)" stroke="var(--fg)" stroke-width="2.5"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; }
</style>
