---
// Infinity-link mark — two connected nodes forming an ∞ with a confident,
// rounded stroke. Restrained node points, no surrounding rings. Related to
// the Growth Graph's connected-node language. Variants: gradient | dark |
// white. Reads in black-and-white and at favicon size.
interface Props {
  size?: number;
  variant?: 'gradient' | 'dark' | 'white';
  class?: string;
  title?: string;
}
const { size = 34, variant = 'gradient', class: className = '', title } = Astro.props;
const gid = 'inf-' + Math.random().toString(36).slice(2, 8);
const paint =
  variant === 'white' ? '#ffffff' : variant === 'dark' ? 'var(--c-ink)' : `url(#${gid})`;
---
<svg
  class:list={['inf', className]}
  width={size}
  height={+((size * 22) / 40).toFixed(1)}
  viewBox="0 0 40 22"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {variant === 'gradient' && (
    <defs>
      <linearGradient id={gid} x1="2" y1="2" x2="38" y2="20" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#4b3fea" />
        <stop offset="52%" stop-color="#7b3fe4" />
        <stop offset="100%" stop-color="#e8409a" />
      </linearGradient>
    </defs>
  )}
  <path
    d="M6 11 C 6 5 14 5 20 11 C 26 17 34 17 34 11 C 34 5 26 5 20 11 C 14 17 6 17 6 11 Z"
    fill="none"
    stroke={paint}
    stroke-width="4.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="6" cy="11" r="3" fill={paint} />
  <circle cx="34" cy="11" r="3" fill={paint} />
</svg>
<style>
  .inf { display: block; }
</style>
