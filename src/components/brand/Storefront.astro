---
// Storefront — the store that turns attention into orders. Bright, dimensional.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <rect x="20" y="44" width="88" height="66" rx="12" fill="var(--c-ivory)"/>
  <rect x="20" y="44" width="88" height="66" rx="12" fill="none" stroke="var(--c-ink)" stroke-width="2.5" opacity="0.12"/>
  <path d="M14 46 L26 24 H102 L114 46 Z" fill="var(--c-orange)"/>
  <path d="M14 46 L26 24 H102 L114 46 Z" fill="none" stroke="var(--c-ink)" stroke-width="2" opacity="0.14" stroke-linejoin="round"/>
  <path d="M26 46 q7 12 14 0 q7 12 14 0 q7 12 14 0 q7 12 14 0 q7 12 14 0" fill="none" stroke="#fff" stroke-width="2.5" opacity="0.7"/>
  <rect x="32" y="58" width="26" height="20" rx="5" fill="var(--c-mint)"/>
  <rect x="70" y="58" width="26" height="20" rx="5" fill="var(--c-yellow)"/>
  <rect x="52" y="84" width="24" height="26" rx="6" fill="var(--c-blue)"/>
  <circle cx="92" cy="96" r="12" fill="var(--c-pink)"/>
  <path d="M87 96 h10 m-4 -4 l4 4 l-4 4" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; filter: drop-shadow(0 8px 14px color-mix(in oklab, var(--c-orange) 22%, transparent)); }
</style>
