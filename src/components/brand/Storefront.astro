---
// Storefront — the store that turns attention into orders.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <rect x="18" y="40" width="92" height="70" rx="4" fill="var(--bg-raised)" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M12 40 L22 22 H106 L116 40 Z" fill="var(--accent)" stroke="var(--fg)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M18 40 v10 a10 10 0 0 0 20 0 v-10" fill="none" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M38 40 v10 a10 10 0 0 0 20 0 v-10" fill="none" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M58 40 v10 a10 10 0 0 0 20 0 v-10" fill="none" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M78 40 v10 a10 10 0 0 0 20 0 v-10" fill="none" stroke="var(--fg)" stroke-width="2.5"/>
  <rect x="54" y="74" width="20" height="36" rx="2" fill="var(--accent-2)" stroke="var(--fg)" stroke-width="2.5"/>
  <path d="M84 84 h16 m0 0 l-6 -6 m6 6 l-6 6" fill="none" stroke="var(--accent-2)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; }
</style>
