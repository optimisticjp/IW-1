---
// Content Stream — attention and story flowing through the system.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <path d="M8 40 C 40 24 72 56 120 34" fill="none" stroke="var(--fg)" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M8 64 C 40 48 72 80 120 58" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round"/>
  <path d="M8 88 C 40 72 72 104 120 82" fill="none" stroke="var(--fg)" stroke-width="2.5" stroke-linecap="round" opacity="0.55"/>
  <circle cx="64" cy="72" r="6" fill="var(--accent)" stroke="var(--fg)" stroke-width="2"/>
  <circle cx="30" cy="55" r="4.5" fill="var(--accent-2)"/>
  <circle cx="100" cy="68" r="4.5" fill="var(--saffron, #f4a72c)"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; }
</style>
