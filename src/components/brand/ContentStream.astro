---
// Content Stream — attention and story flowing through the system.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <path d="M6 42 C 40 24 74 58 122 34" fill="none" stroke="var(--c-violet)" stroke-width="4" stroke-linecap="round"/>
  <path d="M6 66 C 40 48 74 82 122 58" fill="none" stroke="var(--c-blue)" stroke-width="5" stroke-linecap="round"/>
  <path d="M6 90 C 40 72 74 106 122 82" fill="none" stroke="var(--c-pink)" stroke-width="4" stroke-linecap="round" opacity="0.85"/>
  <circle cx="64" cy="74" r="8" fill="var(--c-orange)"/>
  <circle cx="28" cy="55" r="5.5" fill="var(--c-yellow)"/>
  <circle cx="100" cy="68" r="5.5" fill="var(--c-green)"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; filter: drop-shadow(0 8px 14px color-mix(in oklab, var(--c-blue) 22%, transparent)); }
</style>
