---
// Retention Loop — one order becomes many; value returns.
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<svg class:list={['obj', className]} viewBox="0 0 128 128" aria-hidden="true" role="presentation">
  <path d="M98 42 A 42 42 0 1 0 106 74" fill="none" stroke="var(--c-green)" stroke-width="5" stroke-linecap="round"/>
  <path d="M99 26 L102 46 L82 44 Z" fill="var(--c-green)"/>
  <circle cx="64" cy="64" r="18" fill="var(--c-yellow)"/>
  <path d="M56 64 l6 6 l12 -13" fill="none" stroke="var(--c-ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.75"/>
  <circle cx="22" cy="64" r="5.5" fill="var(--c-orange)"/>
  <circle cx="106" cy="64" r="5.5" fill="var(--c-pink)"/>
</svg>
<style>
  .obj { width: 100%; height: auto; max-width: 128px; filter: drop-shadow(0 8px 14px color-mix(in oklab, var(--c-green) 24%, transparent)); }
</style>
