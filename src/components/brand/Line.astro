---
// The Line of value — the brand signature. A continuous SVG stroke that
// connects growth systems. It draws on scroll (via the shared reveal
// controller), collapses to a vertical spine on mobile, and renders fully
// drawn under reduced motion. Decorative: meaning is always in the adjacent
// text, never in the Line alone (FR-050).
interface Props {
  variant?: 'flow' | 'arc' | 'descend';
  state?: 'continuous' | 'leak';
  class?: string;
}
const { variant = 'flow', state = 'continuous', class: className = '' } = Astro.props;

// Path per variant (viewBox 0 0 1200 120 for horizontal flows).
const paths: Record<string, string> = {
  flow: 'M0 60 C 200 60 240 20 400 20 S 620 100 800 100 1000 40 1200 40',
  arc: 'M0 100 C 300 100 340 20 600 20 S 900 100 1200 20',
  descend: 'M40 8 C 40 220 260 260 260 470 S 40 720 40 940',
};
const isDescend = variant === 'descend';
const viewBox = isDescend ? '0 0 300 960' : '0 0 1200 120';
---

<div class:list={['line', `line--${variant}`, `line--${state}`, className]} aria-hidden="true">
  <svg viewBox={viewBox} preserveAspectRatio={isDescend ? 'xMidYMin slice' : 'none'} class="line__svg">
    <path
      class="line__track"
      d={paths[variant]}
      fill="none"
      stroke="var(--rule)"
      stroke-width={isDescend ? 2 : 3}
    />
    <path
      class="line__draw"
      class:list={[state === 'leak' && 'line__draw--leak']}
      d={paths[variant]}
      fill="none"
      stroke="var(--accent)"
      stroke-width={isDescend ? 3 : 4}
      stroke-linecap="round"
    />
  </svg>
</div>

<style>
  .line {
    width: 100%;
    line-height: 0;
    pointer-events: none;
  }
  .line--flow,
  .line--arc {
    height: clamp(60px, 9vw, 120px);
  }
  .line--descend {
    height: 100%;
  }
  .line__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Default (no JS): line is fully drawn. With JS (html.js) it starts hidden
     and draws on scroll when the controller adds .is-drawn. */
  .line__draw {
    stroke-dasharray: var(--len, 2600);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-line) var(--ease-in-out);
  }
  html.js .line__draw:not(.line__draw--leak) {
    stroke-dashoffset: var(--len, 2600);
  }
  html.js .line.is-drawn .line__draw:not(.line__draw--leak) {
    stroke-dashoffset: 0;
  }
  /* Leak state: the value line is dashed/broken and loses opacity. */
  .line__draw--leak {
    stroke: var(--c-vermilion);
    stroke-dasharray: 10 16;
    stroke-dashoffset: 0;
    opacity: 0.55;
    animation: leak-drift 2.4s linear infinite;
  }

  @keyframes leak-drift {
    to {
      stroke-dashoffset: -52;
    }
  }

  /* Reduced motion: fully drawn, no animation. */
  @media (prefers-reduced-motion: reduce) {
    .line__draw {
      stroke-dashoffset: 0 !important;
    }
    .line__draw--leak {
      animation: none;
    }
  }
</style>
