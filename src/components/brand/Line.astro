---
// The Line of value — the brand signature. A continuous stroke whose color
// shifts through the Infinite Weblinks family (orange → pink → violet → blue
// → green) as value travels between systems. Draws on scroll, collapses to a
// vertical spine on mobile, renders fully drawn under reduced motion.
// Decorative: meaning is always in the adjacent text (FR-050).
interface Props {
  variant?: 'flow' | 'arc' | 'descend';
  state?: 'continuous' | 'leak';
  width?: number;
  class?: string;
}
const { variant = 'flow', state = 'continuous', width = 5, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  flow: 'M0 60 C 200 60 240 18 400 18 S 620 104 800 104 1000 34 1200 34',
  arc: 'M0 104 C 300 104 340 18 600 18 S 900 104 1200 18',
  descend: 'M40 8 C 40 220 260 260 260 470 S 40 720 40 940',
};
const isDescend = variant === 'descend';
const viewBox = isDescend ? '0 0 300 960' : '0 0 1200 120';
const gid = 'line-grad-' + Math.random().toString(36).slice(2, 9);
---

<div class:list={['line', `line--${variant}`, `line--${state}`, className]} aria-hidden="true">
  <svg viewBox={viewBox} preserveAspectRatio={isDescend ? 'xMidYMin slice' : 'none'} class="line__svg">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2={isDescend ? '0' : '1'} y2={isDescend ? '1' : '0'}>
        <stop offset="0%" stop-color="var(--c-orange)" />
        <stop offset="28%" stop-color="var(--c-pink)" />
        <stop offset="52%" stop-color="var(--c-violet)" />
        <stop offset="76%" stop-color="var(--c-blue)" />
        <stop offset="100%" stop-color="var(--c-green)" />
      </linearGradient>
    </defs>
    <path
      class="line__track"
      d={paths[variant]}
      fill="none"
      stroke="var(--rule-strong)"
      stroke-width={isDescend ? 2 : 3}
    />
    <path
      class="line__draw"
      class:list={[state === 'leak' && 'line__draw--leak']}
      d={paths[variant]}
      fill="none"
      stroke={state === 'leak' ? 'var(--c-orange)' : `url(#${gid})`}
      stroke-width={width}
      stroke-linecap="round"
    />
  </svg>
</div>

<style>
  .line {
    width: 100%;
    line-height: 0;
    pointer-events: none;
  }
  .line--flow,
  .line--arc {
    height: clamp(64px, 9vw, 132px);
  }
  .line--descend {
    height: 100%;
  }
  .line__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .line__draw {
    stroke-dasharray: var(--len, 2600);
    stroke-dashoffset: 0;
    filter: drop-shadow(0 3px 6px color-mix(in oklab, var(--c-violet) 26%, transparent));
    transition: stroke-dashoffset var(--dur-line) var(--ease-in-out);
  }
  html.js .line__draw:not(.line__draw--leak) {
    stroke-dashoffset: var(--len, 2600);
  }
  html.js .line.is-drawn .line__draw:not(.line__draw--leak) {
    stroke-dashoffset: 0;
  }
  .line__draw--leak {
    stroke-dasharray: 9 15;
    stroke-dashoffset: 0;
    opacity: 0.6;
    filter: none;
    animation: leak-drift 2.4s linear infinite;
  }
  @keyframes leak-drift {
    to {
      stroke-dashoffset: -48;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line__draw {
      stroke-dashoffset: 0 !important;
    }
    .line__draw--leak {
      animation: none;
    }
  }
</style>
