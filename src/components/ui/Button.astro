---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  'aria-label'?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {variant === 'primary' && <span class="btn__arrow" aria-hidden="true">→</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--r-pill);
    border: var(--bw-2) solid transparent;
    min-height: 46px;
    padding: 0.85em 1.5em;
    transition: transform var(--dur-1) var(--ease-spring),
      background-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .btn--lg {
    font-size: var(--fs-body);
    padding: 1.05em 1.9em;
    min-height: 54px;
  }

  /* Primary — bright orange with dark ink text (AA), soft lifted shadow. */
  .btn--primary {
    background: var(--accent);
    color: #2a1405;
    box-shadow: 0 6px 0 -1px color-mix(in oklab, var(--accent) 62%, #000),
      var(--shadow-1);
  }
  [data-env='flare'] .btn--primary {
    background: #2a1405;
    color: var(--c-orange);
    box-shadow: var(--shadow-1);
  }
  [data-env='ink'] .btn--primary {
    color: #ffffff;
    box-shadow: var(--shadow-1);
  }
  .btn--primary:hover {
    transform: translateY(-2px);
  }
  .btn--primary .btn__arrow {
    transition: transform var(--dur-1) var(--ease-out);
  }
  .btn--primary:hover .btn__arrow {
    transform: translateX(4px);
  }

  /* Secondary — friendly outline on the raised surface. */
  .btn--secondary {
    background: var(--bg-raised);
    color: var(--fg);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-1);
  }
  .btn--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--fg);
  }

  .btn--ghost {
    background: transparent;
    color: var(--fg);
    padding-inline: 0.5em;
  }
  .btn--ghost:hover {
    color: var(--link);
  }
</style>
