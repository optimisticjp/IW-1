---
// Accessible breadcrumb (spec 002, FR-005). The current page is a non-link and
// is marked aria-current. Matches the BreadcrumbList schema built in lib/schema.
export interface Crumb {
  label: string;
  href?: string; // omitted for the current (last) page
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol class="crumbs__list">
    {items.map((item, i) => (
      <li class="crumbs__item">
        {item.href && i < items.length - 1 ? (
          <a href={item.href} class="crumbs__link">{item.label}</a>
        ) : (
          <span class="crumbs__current" aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="crumbs__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs__list { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; list-style: none; margin: 0; padding: 0; font-size: var(--fs-caption); }
  .crumbs__item { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .crumbs__link { color: var(--fg-muted); text-decoration: none; }
  .crumbs__link:hover { color: var(--fg); text-decoration: underline; }
  .crumbs__current { color: var(--fg-faint); }
  .crumbs__sep { color: var(--fg-faint); }
</style>
