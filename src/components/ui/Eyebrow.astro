---
interface Props {
  class?: string;
  as?: 'p' | 'span' | 'div';
}
const { class: className = '', as: Tag = 'p' } = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  <span class="eyebrow__tick" aria-hidden="true"></span>
  <span class="eyebrow__text"><slot /></span>
</Tag>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0;
  }
  .eyebrow__tick {
    width: 1.6em;
    height: var(--bw-2);
    background: var(--accent);
    border-radius: var(--r-pill);
    flex: none;
  }
</style>
