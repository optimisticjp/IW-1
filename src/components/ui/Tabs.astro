---
// Accessible tabs (spec 002, FR-021 goal-selection pattern reuse). Real
// tablist/tab/tabpanel roles with arrow-key support. Without JavaScript all
// panels are shown (progressive enhancement), so meaning is never lost.
export interface Tab {
  id: string;
  label: string;
}
interface Props {
  tabs: Tab[];
  label: string; // accessible name for the tablist
}
const { tabs, label } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button
        class="tabs__tab"
        role="tab"
        id={`tab-${t.id}`}
        aria-controls={`panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? '0' : '-1'}
      >{t.label}</button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div class="tabs__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
      <slot name={t.id} />
    </div>
  ))}
</div>

<style>
  .tabs__list { display: flex; flex-wrap: wrap; gap: 0.4rem; border-bottom: var(--bw) solid var(--rule); }
  .tabs__tab { appearance: none; background: none; border: 0; padding: 0.6rem 0.9rem; font: inherit; font-weight: 600; color: var(--fg-muted); cursor: pointer; border-bottom: var(--bw-2) solid transparent; margin-bottom: -1px; min-height: 44px; }
  .tabs__tab[aria-selected='true'] { color: var(--fg); border-bottom-color: var(--cap, var(--accent)); }
  .tabs__tab:focus-visible { outline: var(--bw-2) solid var(--focus); outline-offset: 2px; border-radius: var(--r-1); }
  .tabs__panel { padding-top: 1.2rem; }
  /* No-JS: all panels show (JS marks the root with data-js to take over). */
  .tabs:not([data-js]) .tabs__panel[hidden] { display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (!tabs.length) return;
    const select = (i: number, focus = true) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
        if (on && focus) t.focus();
      });
    };
    // JS is running: mark this tabs root so its CSS enforces single-panel view.
    root.setAttribute('data-js', '');
    select(0, false);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select(i === last ? 0 : i + 1); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select(i === 0 ? last : i - 1); }
        else if (e.key === 'Home') { e.preventDefault(); select(0); }
        else if (e.key === 'End') { e.preventDefault(); select(last); }
      });
    });
  });
</script>
