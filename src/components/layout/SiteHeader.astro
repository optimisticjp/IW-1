---
// Site header (spec 002, FR-001/002/003). Sticky primary nav with the current
// item marked; "What we do" opens a mega-menu of the six capabilities (native
// <details> — keyboard-operable and robust without custom JS). Accessible,
// focus-trapped mobile sheet with the CTA pinned and the mega flattened.
import { primaryNav, bookCta, megaMenu, megaOverview, isCurrent } from '../../data/nav';
import Button from '../ui/Button.astro';
import InfinityMark from '../brand/InfinityMark.astro';

const path = Astro.url.pathname;
// primaryNav[0] is "What we do" (rendered as the mega); the rest are links.
const restNav = primaryNav.filter((i) => i.href !== '/what-we-do');
---

<header class="hdr" data-env="paper">
  <div class="hdr__bar">
    <a class="brand" href="/" aria-label="Infinite Weblinks, home">
      <InfinityMark size={34} />
      <span class="brand__word">Infinite&nbsp;Weblinks</span>
    </a>

    <nav class="nav-d" aria-label="Primary">
      <ul class="nav-d__list">
        <li class="nav-d__item">
          <details class="mega">
            <summary class="nav-d__link mega__summary" aria-current={isCurrent('/what-we-do', path) ? 'page' : undefined}>
              What we do <span class="mega__chev" aria-hidden="true"></span>
            </summary>
            <div class="mega__panel" role="group" aria-label="What we do">
              <div class="mega__grid">
                {megaMenu.map((col) => (
                  <div class="mega__col" data-cap={col.id}>
                    <a href={col.href} class="mega__cap">{col.name}</a>
                    <p class="mega__desc">{col.descriptor}</p>
                    <ul class="mega__svc">
                      {col.services.map((s) => (<li><a href={s.href}>{s.label}</a></li>))}
                    </ul>
                  </div>
                ))}
              </div>
              <a href={megaOverview.href} class="mega__all">{megaOverview.label} →</a>
            </div>
          </details>
        </li>
        {restNav.map((item) => (
          <li class="nav-d__item">
            <a href={item.href} class="nav-d__link" aria-current={isCurrent(item.href, path) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__cta">
      <Button href={bookCta.href} variant="primary" size="md">{bookCta.label}</Button>
    </div>

    <button class="hdr__toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span class="hdr__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <div class="mnav" id="mobile-nav" data-env="paper" hidden>
    <nav class="mnav__inner" aria-label="Primary (mobile)">
      <ul class="mnav__list">
        <li>
          <details class="mnav__group">
            <summary class="mnav__link">What we do</summary>
            <ul class="mnav__sub">
              <li><a href={megaOverview.href}>{megaOverview.label}</a></li>
              {megaMenu.map((col) => (<li><a href={col.href}>{col.name}</a></li>))}
            </ul>
          </details>
        </li>
        {restNav.map((item) => (
          <li><a href={item.href} class="mnav__link" aria-current={isCurrent(item.href, path) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a href={bookCta.href} class="mnav__cta">{bookCta.label} <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: var(--z-header);
    background: color-mix(in oklab, var(--c-paper) 84%, transparent);
    backdrop-filter: saturate(1.3) blur(12px);
    border-bottom: var(--bw) solid var(--rule);
  }
  .hdr--mnav-open { backdrop-filter: none; }
  .hdr__bar {
    position: relative;
    max-width: var(--w-wide); margin-inline: auto;
    padding: 0.7rem var(--gutter); display: flex; align-items: center; gap: 1rem;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--fg);
    font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; margin-right: auto; }

  .nav-d { display: none; }
  .nav-d__list { display: flex; align-items: center; gap: clamp(1rem, 0.4rem + 1.6vw, 2rem); list-style: none; margin: 0; padding: 0; }
  .nav-d__item { position: static; }
  .nav-d__link { position: relative; display: inline-flex; align-items: center; gap: 0.3rem; color: var(--fg); text-decoration: none; font-weight: 500; font-size: var(--fs-small); padding: 0.35rem 0; cursor: pointer; }
  .nav-d__link[aria-current='page'] { color: var(--accent); }
  .nav-d__link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-2) var(--ease-out); }
  .nav-d__link:hover::after, .nav-d__link[aria-current='page']::after { transform: scaleX(1); }

  /* Mega-menu (native details). */
  .mega { position: static; }
  .mega__summary { list-style: none; }
  .mega__summary::-webkit-details-marker { display: none; }
  .mega__summary:focus-visible { outline: var(--bw-2) solid var(--focus); outline-offset: 3px; border-radius: var(--r-1); }
  .mega__chev { width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); transition: transform var(--dur-micro) var(--ease-out); }
  .mega[open] .mega__chev { transform: rotate(-135deg) translateY(-1px); }
  .mega__panel { position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 10px); max-width: calc(var(--w-wide) - (2 * var(--gutter))); background: var(--bg-raised); border: var(--bw) solid var(--rule); border-radius: var(--r-3); box-shadow: var(--shadow-pop); padding: 1.4rem; z-index: var(--z-overlay); }
  .mega__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem 1.6rem; }
  .mega__cap { font-weight: 700; color: var(--cap-deep); text-decoration: none; font-size: var(--fs-small); }
  .mega__desc { color: var(--fg-muted); font-size: var(--fs-caption); margin: 0.15rem 0 0.4rem; }
  .mega__svc { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  .mega__svc a { color: var(--fg); text-decoration: none; font-size: var(--fs-caption); }
  .mega__svc a:hover { text-decoration: underline; }
  .mega__all { display: inline-block; margin-top: 1rem; color: var(--accent); text-decoration: none; font-weight: 600; font-size: var(--fs-small); }

  .hdr__cta { display: none; }

  .hdr__toggle { position: relative; z-index: calc(var(--z-nav) + 1); display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; margin-left: auto; border-radius: var(--r-2); border: var(--bw) solid var(--rule-strong); background: color-mix(in oklab, var(--bg-raised) 92%, transparent); cursor: pointer; }
  .hdr__bars { display: grid; gap: 4px; width: 20px; }
  .hdr__bars i { display: block; height: 2px; background: var(--fg); border-radius: 2px; transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-micro); }
  .hdr__toggle[aria-expanded='true'] .hdr__bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hdr__toggle[aria-expanded='true'] .hdr__bars i:nth-child(2) { opacity: 0; }
  .hdr__toggle[aria-expanded='true'] .hdr__bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mnav { position: fixed; inset: 0; z-index: var(--z-nav); background: var(--bg); color: var(--fg); padding: calc(4.75rem + env(safe-area-inset-top)) var(--gutter) calc(2rem + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; }
  .mnav[hidden] { display: none; }
  .mnav__inner { display: grid; gap: 1.4rem; max-width: 30rem; margin-inline: auto; }
  .mnav__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  .mnav__link { display: block; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h3); color: var(--fg); text-decoration: none; padding: 0.5rem 0; border-bottom: var(--bw) solid var(--rule); cursor: pointer; }
  .mnav__group summary { list-style: none; }
  .mnav__group summary::-webkit-details-marker { display: none; }
  .mnav__sub { list-style: none; margin: 0 0 0.6rem; padding: 0.2rem 0 0 0.6rem; display: grid; gap: 0.35rem; }
  .mnav__sub a { color: var(--fg-muted); text-decoration: none; font-size: var(--fs-lead); }
  .mnav__cta { display: inline-flex; align-items: center; gap: 0.5em; background-image: var(--grad-brand); color: #fff; padding: 0.9rem 1.5rem; border-radius: var(--r-2); font-weight: 700; text-decoration: none; justify-self: start; min-height: 48px; }

  @media (min-width: 900px) {
    .nav-d { display: block; margin-inline: auto; }
    .hdr__cta { display: block; }
    .hdr__toggle { display: none; }
    .mnav { display: none !important; }
  }
  @media (max-width: 899px) { .mega__panel { position: static; box-shadow: none; padding: 0.5rem 0 0; border: 0; } .nav-d { display: none; } }
</style>

<script is:inline type="module" src="/js/site-header.js"></script>
