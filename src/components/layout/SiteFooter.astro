---
import { footerColumns, legalLinks, newsletterEnabled } from '../../data/nav';
import { home } from '../../data/home';
import Button from '../ui/Button.astro';
import InfinityMark from '../brand/InfinityMark.astro';
---

<footer class="ft" data-env="dark">
  <div class="ft__inner">
    <div class="ft__lead">
      <div class="ft__brand">
        <InfinityMark size={40} />
        <span>INFINITE WEBLINKS</span>
      </div>
      <p class="ft__blurb">{home.footer.blurb}</p>
      <Button href="/book-a-call" variant="primary" size="md">Book a free call</Button>

      {newsletterEnabled && (
        <form class="ft__news" method="post" aria-label="Newsletter sign-up">
          <label class="ft__news-label" for="ft-news-email">Occasional, useful updates. No spam.</label>
          <div class="ft__news-row">
            <input id="ft-news-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            <button type="submit">Sign up</button>
          </div>
        </form>
      )}
    </div>

    <nav class="ft__nav" aria-label="Footer">
      {footerColumns.map((group) => (
        <div class="ft__group">
          <h2 class="ft__heading">{group.heading}</h2>
          <ul>
            {group.items.map((item) => (
              <li><a href={item.href} class="ft__link">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="ft__base">
    <p>{home.footer.legal}</p>
    <ul class="ft__legal">
      {legalLinks.map((l) => (<li><a href={l.href} class="ft__link">{l.label}</a></li>))}
    </ul>
    <p class="ft__slogan">{home.footer.slogan}</p>
  </div>
</footer>

<style>
  .ft { background: var(--bg); color: var(--fg); }
  .ft__inner { max-width: var(--w-wide); margin-inline: auto; padding: clamp(3rem, 2rem + 4vw, 5rem) var(--gutter) 2.5rem; display: grid; gap: 2.5rem; }
  .ft__lead { display: grid; gap: 1.1rem; justify-items: start; max-width: 28rem; }
  .ft__brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; letter-spacing: 0.02em; }
  .ft__blurb { color: var(--fg-muted); font-size: var(--fs-small); }
  .ft__nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
  .ft__heading { font-family: var(--font-body); font-size: var(--fs-caption); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-faint); margin-bottom: 0.9rem; }
  .ft__group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .ft__link { color: var(--fg-muted); text-decoration: none; font-size: var(--fs-small); }
  .ft__link:hover { color: var(--fg); }
  .ft__news { display: grid; gap: 0.5rem; width: 100%; max-width: 22rem; margin-top: 0.4rem; }
  .ft__news-label { font-size: var(--fs-caption); color: var(--fg-muted); }
  .ft__news-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .ft__news input { flex: 1 1 12rem; min-width: 0; padding: 0.6rem 0.7rem; border-radius: var(--r-1); border: var(--bw) solid var(--rule-strong); background: var(--bg-raised); color: var(--fg); min-height: 44px; }
  .ft__news button { padding: 0.6rem 1rem; border-radius: var(--r-1); border: 0; background: var(--accent); color: var(--accent-ink); font-weight: 600; min-height: 44px; cursor: pointer; }
  .ft__news :focus-visible { outline: var(--bw-2) solid var(--focus); outline-offset: 2px; }
  .ft__legal { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0; padding: 0; }
  .ft__base { max-width: var(--w-wide); margin-inline: auto; padding: 1.5rem var(--gutter); border-top: var(--bw) solid var(--rule); display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; align-items: center; color: var(--fg-faint); font-size: var(--fs-caption); }
  @media (min-width: 720px) {
    .ft__inner { grid-template-columns: 1fr 1.4fr; gap: 3rem; }
    .ft__nav { grid-template-columns: repeat(4, 1fr); }
  }
</style>
