---
import { footerGroups } from '../../data/nav';
import { home } from '../../data/home';
import Button from '../ui/Button.astro';
import InfinityMark from '../brand/InfinityMark.astro';
---

<footer class="ft" data-env="dark">
  <div class="ft__inner">
    <div class="ft__lead">
      <div class="ft__brand">
        <InfinityMark size={40} />
        <span>INFINITE WEBLINKS</span>
      </div>
      <p class="ft__blurb">{home.footer.blurb}</p>
      <Button href="/book-a-call" variant="primary" size="md">Book a free call</Button>
    </div>

    <nav class="ft__nav" aria-label="Footer">
      {footerGroups.map((group) => (
        <div class="ft__group">
          <h2 class="ft__heading">{group.heading}</h2>
          <ul>
            {group.items.map((item) => (
              <li><a href={item.href} class="ft__link">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="ft__base">
    <p>{home.footer.legal}</p>
    <p class="ft__slogan">{home.footer.slogan}</p>
  </div>
</footer>

<style>
  .ft { background: var(--bg); color: var(--fg); }
  .ft__inner { max-width: var(--w-wide); margin-inline: auto; padding: clamp(3rem, 2rem + 4vw, 5rem) var(--gutter) 2.5rem; display: grid; gap: 2.5rem; }
  .ft__lead { display: grid; gap: 1.1rem; justify-items: start; max-width: 28rem; }
  .ft__brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; letter-spacing: 0.02em; }
  .ft__blurb { color: var(--fg-muted); font-size: var(--fs-small); }
  .ft__nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
  .ft__heading { font-family: var(--font-body); font-size: var(--fs-caption); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-faint); margin-bottom: 0.9rem; }
  .ft__group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .ft__link { color: var(--fg-muted); text-decoration: none; font-size: var(--fs-small); }
  .ft__link:hover { color: var(--fg); }
  .ft__base { max-width: var(--w-wide); margin-inline: auto; padding: 1.5rem var(--gutter); border-top: var(--bw) solid var(--rule); display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; color: var(--fg-faint); font-size: var(--fs-caption); }
  @media (min-width: 720px) {
    .ft__inner { grid-template-columns: 1fr 1.4fr; gap: 3rem; }
    .ft__nav { grid-template-columns: repeat(3, 1fr); }
  }
</style>
