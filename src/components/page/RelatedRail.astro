---
// Related-content rail (spec 002, FR-006). Descriptive links to siblings and
// genuinely-connected services or capabilities. Link text is specific.
import Section from '../layout/Section.astro';

interface Props {
  heading?: string;
  links: { label: string; href: string; note?: string }[];
  env?: 'paper' | 'lavender' | 'mint';
}
const { heading = 'Related', links, env = 'paper' } = Astro.props;
---

{links.length > 0 && (
  <Section env={env} labelledby="related-h" pad="tight">
    <div class="rel">
      <h2 id="related-h" class="rel__h">{heading}</h2>
      <ul class="rel__grid">
        {links.map((l) => (
          <li class="rel__item">
            <a href={l.href} class="rel__link">{l.label}</a>
            {l.note && <p class="rel__note">{l.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </Section>
)}

<style>
  .rel { display: grid; gap: 1.2rem; }
  .rel__h { font-family: var(--font-body); font-size: var(--fs-caption); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-faint); margin: 0; }
  .rel__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem 1.5rem; grid-template-columns: 1fr; }
  .rel__link { font-weight: 600; color: var(--fg); text-decoration: none; }
  .rel__link:hover { color: var(--accent); text-decoration: underline; }
  .rel__note { color: var(--fg-muted); font-size: var(--fs-small); margin: 0.1rem 0 0; }
  @media (min-width: 640px) { .rel__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .rel__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
